{
  "name": "good-read",
  "displayName": "goodRead",
  "description": "",
  "version": "0.0.4",
  "publisher": "GY",
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.readNovel",
    "onCommand:extension.readNovel1",
    "onCommand:extension.showMySidebar",
    "onView:my-sidebar-view"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.readNovel",
        "title": "goodRead",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      },
      {
        "command": "extension.readNovel1",
        "title": "goodRead1",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      },
      {
        "command": "extension.showMySidebar",
        "title": "goodRead_showMySidebar",
        "icon": {
          "light": "./icon.svg",
          "dark": "./icon.svg"
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "my-sidebar",
          "title": "goodRead",
          "icon": "./icon.svg"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "界面",
      "properties": {
        "novelReader.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Novel Reader view."
        }
      }
    },
    "views": {
      "my-sidebar": [
        {
          "type": "webview",
          "id": "my-sidebar-view",
          "name": "",
          "icon": "./icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "extension.readNovel",
          "when": "view == my-sidebar-view",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "extension.readNovel1",
          "when": "view == my-sidebar-view",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "package": "vsce package --allow-missing-repository --no-yarn",
    "build-package": "npm run build && vsce package --allow-missing-repository --no-yarn",
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.2.6",
    "@esbuild/darwin-x64": "0.21.5",
    "@rollup/rollup-darwin-x64": "^4.55.2",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/vscode": "^1.91.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "2.22.0",
    "antd": "^5.12.8",
    "eslint": "^8.57.0",
    "less": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.0.8"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.3"
  },
  "icon": "icon.jpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/GY-Jonh/vscode-goodRead.git"
  }
}
